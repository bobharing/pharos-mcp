{
  "name": "@bobharing/pharos-mcp",
  "version": "1.5.0",
  "description": "A Model Context Protocol (MCP) server that provides web performance auditing, accessibility testing, SEO analysis, security assessment, and Core Web Vitals monitoring using Google Lighthouse. Enables LLMs and AI agents to perform detailed website analysis with 8 specialized tools.",
  "main": "src/index.ts",
  "bin": {
    "pharos-mcp": "src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "inspect": "bunx @modelcontextprotocol/inspector bun run src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "smoke:profile": "bun run scripts/smoke-profile.ts",
    "release-please": "release-please release-pr --repo-url=https://github.com/bobharing/pharos-mcp --package-name=@bobharing/pharos-mcp",
    "release-please:release": "release-please github-release --repo-url=https://github.com/bobharing/pharos-mcp --package-name=@bobharing/pharos-mcp"
  },
  "keywords": [
    "lighthouse",
    "mcp",
    "model-context-protocol",
    "performance",
    "web-performance",
    "audit",
    "seo",
    "accessibility",
    "core-web-vitals",
    "security",
    "wcag",
    "performance-budget",
    "resource-analysis",
    "javascript-optimization",
    "mobile-performance",
    "pwa",
    "progressive-web-app",
    "lcp",
    "inp",
    "cls",
    "chrome",
    "ai-agent",
    "llm-tools",
    "automation",
    "web-audit",
    "performance-monitoring",
    "vscode-extension",
    "cursor",
    "windsurf",
    "claude-desktop"
  ],
  "author": {
    "name": "Bob Haring",
    "url": "https://github.com/bobharing"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobharing/pharos-mcp.git"
  },
  "homepage": "https://github.com/bobharing/pharos-mcp#readme",
  "bugs": {
    "url": "https://github.com/bobharing/pharos-mcp/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@types/bun": "latest",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "release-please": "^17.6.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.3.0",
    "zod": "^4.4.2"
  }
}
